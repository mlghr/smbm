#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "Starting hook" > /tmp/hook.log
# Get staged .gd files and format them
staged_gd_files=$(git diff --cached --name-only -- '*.gd' | grep -E '\.gd$' || true)
if [[ -n "$staged_gd_files" ]]; then
  while IFS= read -r file; do
    if [[ -f "$file" ]]; then
      "$binary" "$file" >/dev/null
    fi
  done <<< "$staged_gd_files"
  # Add back the formatted files
  while IFS= read -r file; do
    git add -- "$file"
  done <<< "$staged_gd_files"
fi
echo "After format and add" >> /tmp/hook.log
