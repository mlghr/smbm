#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "Starting hook" > /tmp/hook.log
./devtools/format.sh
echo "After format" >> /tmp/hook.log
changed_files=$(git diff --name-only -- '*.gd' | grep -E '\.gd$' || true)
if [[ -n "$changed_files" ]]; then
  while IFS= read -r file; do
    git add -- "$file"
  done <<< "$changed_files"
fi
 echo "After add" >> /tmp/hook.log
